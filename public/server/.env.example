# Copy this file to ".env" and fill it in. Never commit .env.

PORT=3000

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sagar_app
DB_PASSWORD=change-me
DB_NAME=sagar_classes

# --- Security ---
# Long random string used to sign admin login tokens (24+ characters).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
TOKEN_TTL=8h

# First admin account. Created automatically on first start if no admin exists.
# After the first start you can delete ADMIN_PASSWORD from this file.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Set to 1 when running behind nginx / a hosting proxy so rate limiting sees real client IPs.
# TRUST_PROXY=1

# Optional: path to a Unicode .ttf (e.g. NotoSans-Regular.ttf) so PDFs can print non-Latin names.
# PDF_FONT_PATH=./fonts/NotoSans-Regular.ttf
